# Neon: the POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon: the DIRECT connection string. Only needed for Prisma CLI commands run by hand.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# Signs the sign-in cookie. Any random string of 16+ characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=""
# First-run passcode. Used only until a passcode is saved in the database.
ADMIN_PASSCODE=""
